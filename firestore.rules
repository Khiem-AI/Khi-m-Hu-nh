rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email is string;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email.lower() == 'khiemhuynhggs@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isMemberOnDoc(data) {
      return isBootstrappedAdmin() ||
        data.ownerUid == request.auth.uid ||
        request.auth.token.email.lower() in data.allowedEmails;
    }

    function isValidMeta(data) {
      return data.ownerUid is string &&
        data.ownerUid.size() >= 1 &&
        data.ownerUid.size() <= 128 &&
        data.allowedEmails is list &&
        data.allowedEmails.size() >= 1 &&
        data.allowedEmails.size() <= 50 &&
        data.allowedEmails[0] is string &&
        data.allowedEmails[0].size() <= 200 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCreateMeta(data) {
      return isValidMeta(data) &&
        (data.ownerUid == request.auth.uid || isAdmin()) &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidUpdateMeta() {
      return incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
    }

    // Entity Validators (Create & Update compatible: never use existing() or diff() inside validators)
    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['key', 'payload', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['key', 'payload', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.key is string && data.key.size() >= 1 && data.key.size() <= 64 &&
        data.payload is map;
    }

    function isValidEquipment(data) {
      return data.keys().hasAll(['maThietBi', 'tenThietBi', 'heThong', 'viTri', 'mucDoRuiRo', 'trangThai', 'tanSuat', 'hanBaoTriTiepTheo', 'nguoiPhuTrach', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['maThietBi', 'tenThietBi', 'thongSoKyThuat', 'heThong', 'viTri', 'mucDoRuiRo', 'trangThai', 'tanSuat', 'hanBaoTriTiepTheo', 'nguoiPhuTrach', 'nguoiGiaoViec', 'email', 'qrCode', 'hinhAnh', 'ngayLapDat', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.maThietBi is string && data.maThietBi.size() >= 1 && data.maThietBi.size() <= 80 &&
        data.tenThietBi is string && data.tenThietBi.size() >= 1 && data.tenThietBi.size() <= 200 &&
        data.heThong is string && data.heThong.size() <= 120 &&
        data.viTri is string && data.viTri.size() <= 160 &&
        data.mucDoRuiRo in ['High', 'Medium', 'Low'] &&
        data.trangThai in ['Hoạt động', 'Bảo trì', 'Đang sửa chữa', 'Tạm dừng'] &&
        data.tanSuat in ['Daily', 'Weekly', 'Monthly', 'Quarterly', 'Yearly'] &&
        data.hanBaoTriTiepTheo is string && data.hanBaoTriTiepTheo.size() <= 32 &&
        data.nguoiPhuTrach is string && data.nguoiPhuTrach.size() <= 300 &&
        (!('thongSoKyThuat' in data) || (data.thongSoKyThuat is string && data.thongSoKyThuat.size() <= 4000)) &&
        (!('nguoiGiaoViec' in data) || (data.nguoiGiaoViec is string && data.nguoiGiaoViec.size() <= 160)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 500)) &&
        (!('qrCode' in data) || (data.qrCode is string && data.qrCode.size() <= 500)) &&
        (!('hinhAnh' in data) || (data.hinhAnh is string && data.hinhAnh.size() <= 450000)) &&
        (!('ngayLapDat' in data) || (data.ngayLapDat is string && data.ngayLapDat.size() <= 32));
    }

    function isValidMaintenancePlan(data) {
      return data.keys().hasAll(['id', 'maThietBi', 'tenThietBi', 'loaiBaoTri', 'tanSuat', 'ngayBaoTriTiepTheo', 'nguoiPhuTrach', 'trangThai', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'maThietBi', 'tenThietBi', 'loaiBaoTri', 'tanSuat', 'ngayBaoTriGanNhat', 'ngayBaoTriTiepTheo', 'nguoiPhuTrach', 'nguoiGiaoViec', 'trangThai', 'ghiChu', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.maThietBi is string && data.maThietBi.size() >= 1 && data.maThietBi.size() <= 80 &&
        data.tenThietBi is string && data.tenThietBi.size() >= 1 && data.tenThietBi.size() <= 200 &&
        data.loaiBaoTri is string && data.loaiBaoTri.size() <= 80 &&
        data.tanSuat in ['Daily', 'Weekly', 'Monthly', 'Quarterly', 'Yearly'] &&
        data.ngayBaoTriTiepTheo is string && data.ngayBaoTriTiepTheo.size() <= 32 &&
        data.nguoiPhuTrach is string && data.nguoiPhuTrach.size() <= 300 &&
        data.trangThai in ['Quá hạn', 'Tới hạn', 'Sắp tới', 'Đúng hạn', 'Bình thường'] &&
        (!('ngayBaoTriGanNhat' in data) || (data.ngayBaoTriGanNhat is string && data.ngayBaoTriGanNhat.size() <= 32)) &&
        (!('nguoiGiaoViec' in data) || (data.nguoiGiaoViec is string && data.nguoiGiaoViec.size() <= 160)) &&
        (!('ghiChu' in data) || (data.ghiChu is string && data.ghiChu.size() <= 1500));
    }

    function isValidMaintenanceHistory(data) {
      return data.keys().hasAll(['id', 'maThietBi', 'tenThietBi', 'ngayThucHien', 'nguoiThucHien', 'moTaCongViec', 'ketQua', 'nguoiLapBaoCao', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'maThietBi', 'tenThietBi', 'loaiCongViec', 'ngayThucHien', 'nguoiThucHien', 'nguoiGiaoViec', 'moTaCongViec', 'thoiGianDungMay', 'ketQua', 'anhTruocXuLy', 'hinhAnh', 'nguoiLapBaoCao', 'chiPhiUocTinh', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.maThietBi is string && data.maThietBi.size() >= 1 && data.maThietBi.size() <= 80 &&
        data.tenThietBi is string && data.tenThietBi.size() >= 1 && data.tenThietBi.size() <= 200 &&
        data.ngayThucHien is string && data.ngayThucHien.size() <= 32 &&
        data.nguoiThucHien is string && data.nguoiThucHien.size() <= 300 &&
        data.moTaCongViec is string && data.moTaCongViec.size() <= 3000 &&
        data.ketQua in ['Đạt', 'Hoàn thành', 'Cần theo dõi', 'Chưa đạt'] &&
        data.nguoiLapBaoCao is string && data.nguoiLapBaoCao.size() <= 160 &&
        (!('loaiCongViec' in data) || (data.loaiCongViec is string && data.loaiCongViec.size() <= 80)) &&
        (!('nguoiGiaoViec' in data) || (data.nguoiGiaoViec is string && data.nguoiGiaoViec.size() <= 160)) &&
        (!('thoiGianDungMay' in data) || data.thoiGianDungMay is number) &&
        (!('chiPhiUocTinh' in data) || data.chiPhiUocTinh is number) &&
        (!('anhTruocXuLy' in data) || (data.anhTruocXuLy is string && data.anhTruocXuLy.size() <= 450000)) &&
        (!('hinhAnh' in data) || (data.hinhAnh is string && data.hinhAnh.size() <= 450000));
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['maTicket', 'tieuDe', 'mucDoUuTien', 'trangThai', 'nguoiLap', 'nguoiPhuTrach', 'ngayTao', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['maTicket', 'tieuDe', 'moTaChiTiet', 'mucDoUuTien', 'trangThai', 'nguoiLap', 'nguoiGiaoViec', 'nguoiPhuTrach', 'ngayTao', 'maThietBi', 'ketQua', 'ngayHoanThanh', 'anhTruocXuLy', 'anhSauXuLy', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.maTicket is string && data.maTicket.size() >= 1 && data.maTicket.size() <= 80 &&
        data.tieuDe is string && data.tieuDe.size() >= 1 && data.tieuDe.size() <= 300 &&
        data.mucDoUuTien in ['Khẩn cấp', 'Cao', 'Trung bình', 'Bình thường', 'Thấp'] &&
        data.trangThai in ['Mới tiếp nhận', 'Chờ xử lý', 'Đang thực hiện', 'Đang xử lý', 'Hoàn thành', 'Hủy'] &&
        data.nguoiLap is string && data.nguoiLap.size() <= 160 &&
        data.nguoiPhuTrach is string && data.nguoiPhuTrach.size() <= 300 &&
        data.ngayTao is string && data.ngayTao.size() <= 32 &&
        (!('moTaChiTiet' in data) || (data.moTaChiTiet is string && data.moTaChiTiet.size() <= 4000)) &&
        (!('nguoiGiaoViec' in data) || (data.nguoiGiaoViec is string && data.nguoiGiaoViec.size() <= 160)) &&
        (!('maThietBi' in data) || (data.maThietBi is string && data.maThietBi.size() <= 80)) &&
        (!('ketQua' in data) || (data.ketQua is string && data.ketQua.size() <= 2000)) &&
        (!('ngayHoanThanh' in data) || (data.ngayHoanThanh is string && data.ngayHoanThanh.size() <= 32)) &&
        (!('anhTruocXuLy' in data) || (data.anhTruocXuLy is string && data.anhTruocXuLy.size() <= 450000)) &&
        (!('anhSauXuLy' in data) || (data.anhSauXuLy is string && data.anhSauXuLy.size() <= 450000));
    }

    function isValidSparePart(data) {
      return data.keys().hasAll(['maVatTu', 'tenVatTu', 'tonThucTe', 'tonToiThieu', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['maVatTu', 'tenVatTu', 'thongSo', 'maThietBi', 'tenThietBiSuDung', 'tonToiThieu', 'tonThucTe', 'donViTinh', 'viTriLuu', 'ghiChu', 'donGia', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.maVatTu is string && data.maVatTu.size() >= 1 && data.maVatTu.size() <= 80 &&
        data.tenVatTu is string && data.tenVatTu.size() >= 1 && data.tenVatTu.size() <= 200 &&
        data.tonThucTe is number && data.tonToiThieu is number &&
        (!('thongSo' in data) || (data.thongSo is string && data.thongSo.size() <= 1000)) &&
        (!('maThietBi' in data) || (data.maThietBi is string && data.maThietBi.size() <= 80)) &&
        (!('tenThietBiSuDung' in data) || (data.tenThietBiSuDung is string && data.tenThietBiSuDung.size() <= 300)) &&
        (!('donViTinh' in data) || (data.donViTinh is string && data.donViTinh.size() <= 40)) &&
        (!('viTriLuu' in data) || (data.viTriLuu is string && data.viTriLuu.size() <= 120)) &&
        (!('ghiChu' in data) || (data.ghiChu is string && data.ghiChu.size() <= 1000)) &&
        (!('donGia' in data) || data.donGia is number);
    }

    function isValidStockTx(data) {
      return data.keys().hasAll(['transId', 'ngay', 'loaiGD', 'maVatTu', 'soLuong', 'nguoiThucHien', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['transId', 'ngay', 'loaiGD', 'maVatTu', 'thietBiSuDung', 'soLuong', 'nguoiThucHien', 'ghiChu', 'donGiaSnapshot', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.transId is string && data.transId.size() >= 1 && data.transId.size() <= 80 &&
        data.ngay is string && data.ngay.size() <= 32 &&
        data.loaiGD in ['Nhập kho', 'Xuất kho sử dụng', 'Hoàn kho'] &&
        data.maVatTu is string && data.maVatTu.size() <= 80 &&
        data.soLuong is number &&
        data.nguoiThucHien is string && data.nguoiThucHien.size() <= 160 &&
        (!('thietBiSuDung' in data) || (data.thietBiSuDung is string && data.thietBiSuDung.size() <= 200)) &&
        (!('ghiChu' in data) || (data.ghiChu is string && data.ghiChu.size() <= 1000)) &&
        (!('donGiaSnapshot' in data) || data.donGiaSnapshot is number);
    }

    function isValidPower10Days(data) {
      return data.keys().hasAll(['id', 'chuKy', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'thoiGianLuu', 'chuKy', 'tuNgay', 'denNgay', 'ngayLamViec', 'loaiCa', 'tbNgayKwh', 'evnBT', 'evnCD', 'evnTD', 'solarBT', 'solarCD', 'pLighting', 'pAcmv', 'pEquipment', 'uChiller', 'uMChiller', 'uComp', 'uPump', 'uCooling', 'uOther', 'oAcmv', 'oSocket', 'oKit', 'oServer', 'oLighting', 'nguoiChot', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
        data.chuKy is string && data.chuKy.size() <= 80 &&
        (!('thoiGianLuu' in data) || (data.thoiGianLuu is string && data.thoiGianLuu.size() <= 40)) &&
        (!('tuNgay' in data) || (data.tuNgay is string && data.tuNgay.size() <= 32)) &&
        (!('denNgay' in data) || (data.denNgay is string && data.denNgay.size() <= 32)) &&
        (!('ngayLamViec' in data) || data.ngayLamViec is number) &&
        (!('loaiCa' in data) || (data.loaiCa is string && data.loaiCa.size() <= 40)) &&
        (!('tbNgayKwh' in data) || data.tbNgayKwh is number) &&
        (!('evnBT' in data) || data.evnBT is number) &&
        (!('evnCD' in data) || data.evnCD is number) &&
        (!('evnTD' in data) || data.evnTD is number) &&
        (!('solarBT' in data) || data.solarBT is number) &&
        (!('solarCD' in data) || data.solarCD is number) &&
        (!('pLighting' in data) || data.pLighting is number) &&
        (!('pAcmv' in data) || data.pAcmv is number) &&
        (!('pEquipment' in data) || data.pEquipment is number) &&
        (!('uChiller' in data) || data.uChiller is number) &&
        (!('uMChiller' in data) || data.uMChiller is number) &&
        (!('uComp' in data) || data.uComp is number) &&
        (!('uPump' in data) || data.uPump is number) &&
        (!('uCooling' in data) || data.uCooling is number) &&
        (!('uOther' in data) || data.uOther is number) &&
        (!('oAcmv' in data) || data.oAcmv is number) &&
        (!('oSocket' in data) || data.oSocket is number) &&
        (!('oKit' in data) || data.oKit is number) &&
        (!('oServer' in data) || data.oServer is number) &&
        (!('oLighting' in data) || data.oLighting is number) &&
        (!('nguoiChot' in data) || (data.nguoiChot is string && data.nguoiChot.size() <= 160));
    }

    function isValidWaterMonthly(data) {
      return data.keys().hasAll(['month', 'waterM3', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['month', 'waterM3', 'waterVND', 'waterUSD', 'sewageVND', 'sewageUSD', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.month is string && data.month.size() >= 1 && data.month.size() <= 32 &&
        data.waterM3 is number &&
        (!('waterVND' in data) || data.waterVND is number) &&
        (!('waterUSD' in data) || data.waterUSD is number) &&
        (!('sewageVND' in data) || data.sewageVND is number) &&
        (!('sewageUSD' in data) || data.sewageUSD is number);
    }

    function isValidMeterReading(data) {
      return data.keys().hasAll(['id', 'ngayChot', 'nguon', 'tenDongHo', 'chiSoCu', 'chiSoMoi', 'tieuThu', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'timestamp', 'ngayChot', 'nguon', 'tenDongHo', 'chiSoCu', 'chiSoMoi', 'tieuThu', 'donVi', 'nguoiGhi', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 80 &&
        data.ngayChot is string && data.ngayChot.size() <= 32 &&
        data.nguon is string && data.nguon.size() <= 60 &&
        data.tenDongHo is string && data.tenDongHo.size() <= 160 &&
        data.chiSoCu is number && data.chiSoMoi is number && data.tieuThu is number &&
        (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 40)) &&
        (!('donVi' in data) || (data.donVi is string && data.donVi.size() <= 32)) &&
        (!('nguoiGhi' in data) || (data.nguoiGhi is string && data.nguoiGhi.size() <= 160));
    }

    function isValidCostRecord(data) {
      return data.keys().hasAll(['idChiPhi', 'ngayGhiNhan', 'phanLoai', 'soTienVND', 'trangThai', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['idChiPhi', 'ngayGhiNhan', 'phanLoai', 'thamChieu', 'soTienVND', 'nhaCungCap', 'trangThai', 'ghiChu', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.idChiPhi is string && data.idChiPhi.size() >= 1 && data.idChiPhi.size() <= 80 &&
        data.ngayGhiNhan is string && data.ngayGhiNhan.size() <= 32 &&
        data.phanLoai is string && data.phanLoai.size() <= 120 &&
        data.soTienVND is number &&
        data.trangThai is string && data.trangThai.size() <= 60 &&
        (!('thamChieu' in data) || (data.thamChieu is string && data.thamChieu.size() <= 160)) &&
        (!('nhaCungCap' in data) || (data.nhaCungCap is string && data.nhaCungCap.size() <= 200)) &&
        (!('ghiChu' in data) || (data.ghiChu is string && data.ghiChu.size() <= 1000));
    }

    function isValidEmployeePublic(data) {
      return data.keys().hasAll(['maNhanVien', 'tenNhanVien', 'chucVu', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['maNhanVien', 'tenNhanVien', 'date', 'chucVu', 'ngayVao', 'username', 'quyenHan', 'allowedViews', 'anhDaiDien', 'gioiTinh', 'phongBan', 'chuyenMon', 'loaiHopDong', 'caLamViec', 'ngayNghiPhepNam', 'ngayNghiPhepDaDung', 'ghiChuHoSo', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.maNhanVien is string && data.maNhanVien.size() >= 1 && data.maNhanVien.size() <= 60 &&
        data.tenNhanVien is string && data.tenNhanVien.size() >= 1 && data.tenNhanVien.size() <= 160 &&
        data.chucVu is string && data.chucVu.size() <= 120 &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        (!('ngayVao' in data) || (data.ngayVao is string && data.ngayVao.size() <= 32)) &&
        (!('username' in data) || (data.username is string && data.username.size() <= 120)) &&
        (!('quyenHan' in data) || (data.quyenHan is list && data.quyenHan.size() <= 30 && (data.quyenHan.size() == 0 || data.quyenHan[0] is string))) &&
        (!('allowedViews' in data) || (data.allowedViews is list && data.allowedViews.size() <= 30 && (data.allowedViews.size() == 0 || data.allowedViews[0] is string))) &&
        (!('anhDaiDien' in data) || (data.anhDaiDien is string && data.anhDaiDien.size() <= 450000)) &&
        (!('gioiTinh' in data) || data.gioiTinh in ['Nam', 'Nữ', 'Khác']) &&
        (!('phongBan' in data) || (data.phongBan is string && data.phongBan.size() <= 120)) &&
        (!('chuyenMon' in data) || (data.chuyenMon is string && data.chuyenMon.size() <= 300)) &&
        (!('loaiHopDong' in data) || data.loaiHopDong in ['Chính thức', 'Thử việc', 'Thời vụ', 'Quản lý']) &&
        (!('caLamViec' in data) || (data.caLamViec is string && data.caLamViec.size() <= 120)) &&
        (!('ngayNghiPhepNam' in data) || (data.ngayNghiPhepNam is number && data.ngayNghiPhepNam >= 0 && data.ngayNghiPhepNam <= 365)) &&
        (!('ngayNghiPhepDaDung' in data) || (data.ngayNghiPhepDaDung is number && data.ngayNghiPhepDaDung >= 0 && data.ngayNghiPhepDaDung <= 365)) &&
        (!('ghiChuHoSo' in data) || (data.ghiChuHoSo is string && data.ghiChuHoSo.size() <= 1500));
    }

    function isValidEmployeePrivate(data) {
      return data.keys().hasAll(['maNhanVien', 'email', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['maNhanVien', 'email', 'soDienThoai', 'ngaySinh', 'queQuan', 'diaChiThuongTru', 'soCCCD', 'ngayCapCCCD', 'noiCapCCCD', 'trinhDoHocVan', 'tinhTrangHonNhan', 'nguoiLienHeKhanCap', 'sdtKhanCap', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt']) &&
        isValidMeta(data) &&
        data.maNhanVien is string && data.maNhanVien.size() >= 1 && data.maNhanVien.size() <= 60 &&
        data.email is string && data.email.size() <= 200 &&
        (!('soDienThoai' in data) || (data.soDienThoai is string && data.soDienThoai.size() <= 40)) &&
        (!('ngaySinh' in data) || (data.ngaySinh is string && data.ngaySinh.size() <= 32)) &&
        (!('queQuan' in data) || (data.queQuan is string && data.queQuan.size() <= 200)) &&
        (!('diaChiThuongTru' in data) || (data.diaChiThuongTru is string && data.diaChiThuongTru.size() <= 300)) &&
        (!('soCCCD' in data) || (data.soCCCD is string && data.soCCCD.size() <= 32)) &&
