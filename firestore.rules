    // Collection Rules
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminDoc(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(uid) && isValidAdminDoc(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn() && (resource == null || isAdmin() || isMemberOnDoc(existing()));
      allow list: if isSignedIn() && isMemberOnDoc(existing());
      allow create: if isValidId(settingId) && isSignedIn() && isValidSetting(incoming()) && isValidCreateMeta(incoming());
      allow update: if isValidId(settingId) && isSignedIn() && isValidSetting(incoming()) && isValidUpdateMeta() && (isAdmin() || (isMemberOnDoc(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'allowedEmails', 'updatedAt'])));
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /equipment/{docId} {
      allow get: if isValidId(docId) && isSignedIn() && (resource == null || isAdmin() || isMemberOnDoc(existing()));
